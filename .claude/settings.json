      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(which:*)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
